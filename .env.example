# Exemplo de configurações (copie para .env)
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
POSTGRES_DB=ai_assistant
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5433/ai_assistant

# Barramento de Eventos e Estado Efêmero (Redis)
REDIS_URL=redis://localhost:6379/0

LLAMA_SERVER_URL=http://localhost:8080/v1
LLAMA_MODEL_ALIAS=qwen-coder

# Configurações de Áudio e Captura de Voz
# AUDIO_INPUT_DEVICE=Fuxi-H3        # Nome parcial ou índice (deixe em branco para o padrão do SO)
# AUDIO_SILENCE_THRESHOLD=0.0020     # Limiar RMS para detectar início de fala
# AUDIO_SILENCE_TIMEOUT=0.8          # Segundos de pausa para fechar a elocução

# Discord Integration
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
